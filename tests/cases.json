[
  {
    "name": "split fixed secret",
    "request": {
      "operation": "split",
      "secret_hex": "cafebabe",
      "threshold": 2,
      "shares": 3,
      "seed": 7
    },
    "expected": {
      "algorithm": "shamir-gf256",
      "secret_bytes": 4,
      "threshold": 2,
      "shares": 3,
      "digest": "b51d571d",
      "share_encoding": "hex",
      "commit": "crc32"
    }
  },
  {
    "name": "split error threshold below two",
    "error": "threshold must be a whole number 2..255",
    "request": {
      "operation": "split",
      "secret_hex": "ab",
      "threshold": 1,
      "shares": 3
    }
  },
  {
    "name": "split error shares below threshold",
    "error": "shares must be at least the threshold: 4",
    "request": {
      "operation": "split",
      "secret_hex": "ab",
      "threshold": 4,
      "shares": 3
    }
  },
  {
    "name": "combine error below threshold",
    "error": "need at least 3 shares to combine, got 2",
    "request": {
      "operation": "combine",
      "shares": [
        {
          "index": 1,
          "threshold": 3,
          "digest": "00000000",
          "data": "ab"
        },
        {
          "index": 2,
          "threshold": 3,
          "digest": "00000000",
          "data": "cd"
        }
      ]
    }
  },
  {
    "name": "diagnose names corrupted share",
    "request": {
      "operation": "diagnose",
      "shares": [
        {
          "index": 1,
          "threshold": 2,
          "digest": "59bc5767",
          "data": "9b"
        },
        {
          "index": 2,
          "threshold": 2,
          "digest": "59bc5767",
          "data": "c3"
        },
        {
          "index": 3,
          "threshold": 2,
          "digest": "59bc5767",
          "data": "ff"
        }
      ]
    },
    "expected": {
      "consistent": true,
      "suspects": [
        3
      ],
      "good": [
        1,
        2
      ]
    }
  },
  {
    "name": "verify reports consistency without the secret",
    "request": {
      "operation": "verify",
      "shares": [
        {
          "index": 1,
          "threshold": 2,
          "digest": "59bc5767",
          "data": "9b"
        },
        {
          "index": 2,
          "threshold": 2,
          "digest": "59bc5767",
          "data": "c3"
        }
      ]
    },
    "expected": {
      "verified": true,
      "secret_length": 1
    }
  },
  {
    "name": "words split recovers like hex",
    "request": {
      "operation": "split",
      "secret_hex": "5a",
      "threshold": 2,
      "shares": 3,
      "seed": 1,
      "share_encoding": "words"
    },
    "expected": {
      "share_encoding": "words",
      "secret_bytes": 1
    }
  }
]
