///|
/// Generated-input laws for the field and the interpolation, beside the
/// exhaustive white-box tests: the generator picks, the algebra holds.
/// Each property takes one generated Int32 and extracts its bytes - two
/// bytes per 16-bit slice - so the standard Arbitrary instance carries
/// every case and shrinking stays free.

///|
test "property: multiplication is commutative on generated bytes" {
  @quickcheck.check(
    (word : Int32) => {
      let a = word & 0xFF
      let b = (word >> 8) & 0xFF
      gf_mul(a, b) == gf_mul(b, a)
    },
    count=500,
  )
}

///|
test "property: distribution over xor on generated bytes" {
  @quickcheck.check(
    (word : Int32) => {
      let a = word & 0xFF
      let b = (word >> 8) & 0xFF
      let c = (word >> 16) & 0xFF
      gf_mul(a, (b ^ c) & 0xFF) == (gf_mul(a, b) ^ gf_mul(a, c))
    },
    count=500,
  )
}

///|
test "property: every generated nonzero byte inverts to one" {
  @quickcheck.check(
    (word : Int32) => {
      let byte = (word & 0xFF) | 1
      gf_mul(byte, gf_inv(byte)) == 1
    },
    count=500,
  )
}

///|
test "property: interpolation inverts evaluation on generated polys" {
  // Twenty-four generated bits pack a degree-2 polynomial: secret byte,
  // then two coefficients. Three fixed nonzero x's evaluate it, and the
  // interpolation at zero must hand back the secret byte.
  @quickcheck.check(
    (word : Int32) => {
      let coefficients : Array[Int32] = [
        word & 0xFF,
        (word >> 8) & 0xFF,
        (word >> 16) & 0xFF,
      ]
      let points : Array[(Int32, Int32)] = []
      for x in [1, 2, 3] {
        points.push((x, gf_eval(coefficients, x)))
      }
      gf_interpolate_zero(points) == (word & 0xFF)
    },
    count=500,
  )
}

///|
/// The law of the scheme on generated parameters: bytes 0..3 of the
/// generated array are the secret (its length is 1 + byte 3 mod 4),
/// byte 4 picks a threshold 2..8, byte 5 a share count threshold..10,
/// and bytes 6..7 the seed. Split, then combine the first k shares,
/// and the secret returns verified.
test "property: split-then-combine returns the generated secret" {
  @quickcheck.check(
    (words : Array[Int32]) => {
      if words.length() < 8 {
        return true
      }
      let length = 1 + (words[3] & 0x3)
      let secret : Array[Int32] = []
      for i in 0..<length {
        secret.push(words[i] & 0xFF)
      }
      let threshold = 2 + (words[4] & 0x7)
      let shares = threshold + (words[5] & 0x3)
      let seed = ((words[6] & 0xFFFF).to_int64() << 16) |
        (words[7] & 0xFFFF).to_int64()
      let split = shamir_split(
        secret,
        threshold,
        shares,
        seed.reinterpret_as_uint64(),
        "crc32",
        [],
      )
      let chosen : Array[Share] = []
      for i in 0..<threshold {
        chosen.push(split[i])
      }
      let (recovered, verified) = shamir_combine(chosen, [])
      verified && recovered == secret
    },
    count=300,
  )
}

///|
/// Encodings round-trip on generated bytes: base64 through the codec
/// and back is the identity.
test "property: base64 payload round trip" {
  @quickcheck.check(
    (bytes : Array[Int32]) => {
      if bytes.length() == 0 || bytes.length() > 64 {
        return true
      }
      let clean : Array[Int32] = []
      for byte in bytes {
        clean.push(byte & 0xFF)
      }
      share_bytes_from_base64(share_bytes_to_base64(clean)) == clean
    },
    count=300,
  )
}

///|
/// The fingerprint is order-insensitive on generated splits: whatever
/// subset the generator packs, shuffling the share list cannot move it.
test "property: fingerprint ignores share order" {
  @quickcheck.check(
    (word : Int32) => {
      let secret : Array[Int32] = [word & 0xFF, (word >> 8) & 0xFF]
      let split = shamir_split(secret, 2, 5, word.to_uint64(), "crc32", [])
      let forward = shamir_fingerprint([split[0], split[3], split[4]])
      let rotated = shamir_fingerprint([split[4], split[0], split[3]])
      forward == rotated
    },
    count=300,
  )
}

///|
/// Words encode-decode is the identity on generated shares: the
/// positional layout and its checksum survive the round trip.
test "property: words encoding round-trips" {
  @quickcheck.check(
    (word : Int32) => {
      let secret : Array[Int32] = [
        word & 0xFF,
        (word >> 8) & 0xFF,
        (word >> 16) & 0xFF,
      ]
      let split = shamir_split(secret, 3, 4, word.to_uint64(), "crc32", [])
      let share = split[1]
      let words = mnemonic_encode(share.index, share.threshold, share.data)
      let decoded = mnemonic_decode(words)
      decoded.index == share.index &&
      decoded.threshold == share.threshold &&
      decoded.data == share.data
    },
    count=300,
  )
}

///|
/// The batch law on generated requests: split_many's position i
/// answers exactly a standalone split at seed + i - the contract the
/// batch API promises, held on generated secrets, thresholds, counts
/// and seeds, compared share-for-share through the boundary. A refusal
/// from either path fails the property (and shrinks toward the
/// offense): the generated parameters are all in range, so there is
/// nothing legitimate to refuse.
test "property: split_many position i equals a standalone split at seed+i" {
  @quickcheck.check(
    (words : Array[Int32]) => {
      if words.length() < 16 {
        return true
      }
      let count = 2 + (words[0] & 0x3)
      let length = 1 + (words[1] & 0x3)
      let secrets : Array[Value] = []
      for s in 0..<count {
        let secret : Array[Int32] = []
        for i in 0..<length {
          secret.push(words[(s * length + i + 2) & 0xF] & 0xFF)
        }
        secrets.push(String(to_hex(secret)))
      }
      let threshold = 2 + (words[15] & 0x3)
      let shares = threshold + (words[14] & 0x3)
      let seed = ((words[13] & 0xFFFF).to_int64() << 16) |
        (words[12] & 0xFFFF).to_int64()
      let batch_wrapped : Result[Value, InputError] = Ok(
        split_many_with(
          record([
            ("operation", String("split_many")),
            ("secrets", Array(secrets)),
            ("threshold", Number(threshold.to_double())),
            ("shares", Number(shares.to_double())),
            ("seed", Number(seed.to_double())),
          ]),
        ),
      ) catch {
        e => Err(e)
      }
      let batch = match batch_wrapped {
        Ok(report) => report
        Err(_) => return false
      }
      let splits = match get(batch, "splits") {
        Array(items) => items
        _ => return false
      }
      if splits.length() != count {
        return false
      }
      for i, entry in splits {
        let derived = (seed.reinterpret_as_uint64() + i.to_uint64()) &
          0x1FFFFFFFFFFFFFUL
        let solo_wrapped : Result[Value, InputError] = Ok(
          split_with(
            record([
              ("operation", String("split")),
              ("secret_hex", secrets[i]),
              ("threshold", Number(threshold.to_double())),
              ("shares", Number(shares.to_double())),
              ("seed", Number(derived.to_double())),
            ]),
          ),
        ) catch {
          e => Err(e)
        }
        let solo = match solo_wrapped {
          Ok(report) => report
          Err(_) => return false
        }
        if get(entry, "share_list") != get(solo, "share_list") {
          return false
        }
      }
      true
    },
    count=150,
  )
}
