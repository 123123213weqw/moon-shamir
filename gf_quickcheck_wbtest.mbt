///|
/// Generated-input laws for the field and the interpolation, beside the
/// exhaustive white-box tests: the generator picks, the algebra holds.
/// Each property takes one generated Int32 and extracts its bytes - two
/// bytes per 16-bit slice - so the standard Arbitrary instance carries
/// every case and shrinking stays free.

///|
test "property: multiplication is commutative on generated bytes" {
  @quickcheck.check(
    (word : Int32) => {
      let a = word & 0xFF
      let b = (word >> 8) & 0xFF
      gf_mul(a, b) == gf_mul(b, a)
    },
    count=500,
  )
}

///|
test "property: distribution over xor on generated bytes" {
  @quickcheck.check(
    (word : Int32) => {
      let a = word & 0xFF
      let b = (word >> 8) & 0xFF
      let c = (word >> 16) & 0xFF
      gf_mul(a, (b ^ c) & 0xFF) == (gf_mul(a, b) ^ gf_mul(a, c))
    },
    count=500,
  )
}

///|
test "property: every generated nonzero byte inverts to one" {
  @quickcheck.check(
    (word : Int32) => {
      let byte = (word & 0xFF) | 1
      gf_mul(byte, gf_inv(byte)) == 1
    },
    count=500,
  )
}

///|
test "property: interpolation inverts evaluation on generated polys" {
  // Twenty-four generated bits pack a degree-2 polynomial: secret byte,
  // then two coefficients. Three fixed nonzero x's evaluate it, and the
  // interpolation at zero must hand back the secret byte.
  @quickcheck.check(
    (word : Int32) => {
      let coefficients : Array[Int32] = [
        word & 0xFF,
        (word >> 8) & 0xFF,
        (word >> 16) & 0xFF,
      ]
      let points : Array[(Int32, Int32)] = []
      for x in [1, 2, 3] {
        points.push((x, gf_eval(coefficients, x)))
      }
      gf_interpolate_zero(points) == (word & 0xFF)
    },
    count=500,
  )
}

///|
/// The law of the scheme on generated parameters: bytes 0..3 of the
/// generated array are the secret (its length is 1 + byte 3 mod 4),
/// byte 4 picks a threshold 2..8, byte 5 a share count threshold..10,
/// and bytes 6..7 the seed. Split, then combine the first k shares,
/// and the secret returns verified.
test "property: split-then-combine returns the generated secret" {
  @quickcheck.check(
    (words : Array[Int32]) => {
      if words.length() < 8 {
        return true
      }
      let length = 1 + (words[3] & 0x3)
      let secret : Array[Int32] = []
      for i in 0..<length {
        secret.push(words[i] & 0xFF)
      }
      let threshold = 2 + (words[4] & 0x7)
      let shares = threshold + (words[5] & 0x3)
      let seed = ((words[6] & 0xFFFF).to_int64() << 16) |
        (words[7] & 0xFFFF).to_int64()
      let split = shamir_split(
        secret,
        threshold,
        shares,
        seed.reinterpret_as_uint64(),
        "crc32",
        [],
      )
      let chosen : Array[Share] = []
      for i in 0..<threshold {
        chosen.push(split[i])
      }
      let (recovered, verified) = shamir_combine(chosen, [])
      verified && recovered == secret
    },
    count=300,
  )
}

///|
/// Encodings round-trip on generated bytes: base64 through the codec
/// and back is the identity.
test "property: base64 payload round trip" {
  @quickcheck.check(
    (bytes : Array[Int32]) => {
      if bytes.length() == 0 || bytes.length() > 64 {
        return true
      }
      let clean : Array[Int32] = []
      for byte in bytes {
        clean.push(byte & 0xFF)
      }
      share_bytes_from_base64(share_bytes_to_base64(clean)) == clean
    },
    count=300,
  )
}
