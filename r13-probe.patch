Probe for F5 red check: on pristine main, a fixture-locked transaction with a
SUCCESSFUL parameter writes the PRODUCTION ledger/sysctl.d paths because the
destinations are not threaded through the guard. Uses only tip APIs
(lock_ledger_at, apply_locked, load_rollback_from). NOT part of any PR.

diff --git a/src/ktuner/src/tuner/mod.rs b/src/ktuner/src/tuner/mod.rs
--- a/src/ktuner/src/tuner/mod.rs
+++ b/src/ktuner/src/tuner/mod.rs
@@ -2383,6 +2383,66 @@ fn test_apply_quiet_reports_no_clamps_when_nothing_lands() {
         fs::remove_dir_all(dir).unwrap();
     }

+    fn probe_fixture_body() {
+        let prod_ledger_before = fs::read_to_string(ROLLBACK_PATH).ok();
+        let prod_sysctl_before = fs::read_to_string(SYSCTL_PERSIST_PATH).ok();
+        let dir = std::env::temp_dir().join(format!(
+            "ktuner_probe_redirect_{}_{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        fs::create_dir_all(&dir).unwrap();
+        let ledger = dir.join("rollback.json");
+        let rec = Recommendation {
+            param: "net.core.somaxconn".to_string(),
+            current_value: "stale gathered value".to_string(),
+            recommended_value: "65535".to_string(),
+            writable: true,
+            ..Default::default()
+        };
+        let guard = lock_ledger_at(ledger.to_str().unwrap()).unwrap();
+        let outcome = apply_locked(&[rec], true, &guard).expect("probe apply");
+        drop(guard);
+        assert_eq!(outcome.applied, 1);
+        let data = load_rollback_from(ledger.to_str().unwrap()).unwrap();
+        assert_eq!(
+            data.entries["net.core.somaxconn"].previous, "128",
+            "the readable original must be recorded in the FIXTURE ledger"
+        );
+        assert_eq!(
+            fs::read_to_string(ROLLBACK_PATH).ok(),
+            prod_ledger_before,
+            "PROBE: fixture run wrote the production ledger"
+        );
+        assert_eq!(
+            fs::read_to_string(SYSCTL_PERSIST_PATH).ok(),
+            prod_sysctl_before,
+            "PROBE: fixture run wrote the production sysctl.d file"
+        );
+        fs::remove_dir_all(&dir).ok();
+    }
+
+    #[test]
+    #[ignore = "requires root and private mount namespaces; only fixture files are written"]
+    fn probe_fixture_lock_redirect() {
+        if std::env::var_os("KTUNER_PROBE_CHILD").is_some() {
+            probe_fixture_body();
+            return;
+        }
+        assert_eq!(unsafe { libc::geteuid() }, 0);
+        let dir = std::env::temp_dir().join(format!("ktuner-probe-{}", std::process::id()));
+        fs::create_dir_all(&dir).unwrap();
+        fs::write(dir.join("somaxconn"), "128").unwrap();
+        let before = fs::read_to_string("/proc/sys/net/core/somaxconn").unwrap();
+        let out = std::process::Command::new("unshare")
+            .args(["--mount", "--propagation", "private", "sh", "-ec",
+                "mount --bind \"$1/somaxconn\" /proc/sys/net/core/somaxconn; KTUNER_PROBE_CHILD=1 exec \"$2\" --exact probe_fixture_lock_redirect --ignored --nocapture",
+                "probe-test"])
+            .arg(&dir)
+            .arg(std::env::current_exe().unwrap())
+            .output()
+            .unwrap();
+        assert_eq!(
+            fs::read_to_string("/proc/sys/net/core/somaxconn").unwrap(),
+            before
+        );
+        let _ = fs::remove_dir_all(&dir);
+        assert!(
+            out.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&out.stdout),
+            String::from_utf8_lossy(&out.stderr)
+        );
+    }
